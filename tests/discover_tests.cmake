# Run after natscpp_unit_tests is built: asks it for its tests (--list) and writes one CTest test per test
# function to OUT, which CTest includes (see TEST_INCLUDE_FILES in CMakeLists.txt).
#   cmake -DEXE=<natscpp_unit_tests> -DOUT=<file> -P discover_tests.cmake
execute_process(COMMAND "${EXE}" --list
                OUTPUT_VARIABLE listing RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${EXE} --list failed (${rc}): ${err}")
endif()

string(REPLACE "\n" ";" names "${listing}")
set(content "# Generated by tests/discover_tests.cmake from `natscpp_unit_tests --list`.\n")
foreach(name IN LISTS names)
  if(name STREQUAL "")
    continue()
  endif()
  string(REGEX MATCH "^[a-z]+" group "${name}")
  # Server tests share one set of servers, so they never run concurrently with each other under ctest -j.
  set(lock "")
  if(NOT group STREQUAL "unit")
    set(lock " RESOURCE_LOCK nats_servers")
  endif()
  string(APPEND content
    "add_test([=[${name}]=] [==[${EXE}]==] [=[${name}]=])\n"
    "set_tests_properties([=[${name}]=] PROPERTIES LABELS ${group} SKIP_RETURN_CODE 77 TIMEOUT 120${lock})\n")
endforeach()
file(WRITE "${OUT}" "${content}")
